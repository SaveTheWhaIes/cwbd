# this is the base image the container is built on. In this case, it is a slim version of the Debian operating system.
# trixie instead of the provided bullseye: bullseye is end of life and its security repository returns 404 for curl
FROM debian:trixie-slim

# these are the labels that are added to the image. They are metadata that can be used to identify the author of the image.
LABEL image.author.name="Laurens Hahn"
LABEL image.author.email="129853501+SaveTheWhaIes@users.noreply.github.com"

# update the package list, install curl and cowsay, then drop the package lists to keep the image small
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl cowsay && \
    rm -rf /var/lib/apt/lists/*

# Debian installs cowsay to /usr/games, which is not on the default PATH
ENV PATH="/usr/games:${PATH}"
